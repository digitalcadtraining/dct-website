// DigitalCAD Training - Supabase PostgreSQL + Prisma schema
// Use with Supabase Postgres. For local setup run:
// npx prisma generate
// npx prisma db push
// npm run db:seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionType {
  THEORY
  CAD
  BOTH
}

enum BatchStatus {
  PENDING_APPROVAL
  UPCOMING
  ACTIVE
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ScheduledSessionStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  RESUBMIT
}

enum QueryStatus {
  OPEN
  RESOLVED
}

enum OtpPurpose {
  STUDENT_REGISTER
  TUTOR_REGISTER
  LOGIN
  PASSWORD_RESET
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String   @unique
  password_hash String
  role          Role     @default(STUDENT)
  is_verified   Boolean  @default(false)
  is_active     Boolean  @default(true)
  avatar_url    String?
  referral_code String?  @unique
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  enrollments           Enrollment[]
  tutor_application     TutorApplication?
  tutor_batches         Batch[]                @relation("TutorBatches")
  submissions           AssignmentSubmission[]
  queries               Query[]
  refresh_tokens        RefreshToken[]
  prerequisite_progress PrerequisiteProgress[]
  discount_codes        DiscountCode[]         @relation("DiscountCodeCreatedBy")
  referrals_made        ReferralReward[]       @relation("ReferralsMade")
  referrals_received    ReferralReward[]       @relation("ReferralsReceived")

  @@index([role])
  @@index([is_active])
  @@index([referral_code])
  @@map("users")
}

model OtpVerification {
  id         String     @id @default(cuid())
  phone      String
  otp        String
  purpose    OtpPurpose
  expires_at DateTime
  is_used    Boolean    @default(false)
  attempts   Int        @default(0)
  created_at DateTime   @default(now())

  @@index([phone, purpose])
  @@index([expires_at])
  @@map("otp_verifications")
}

model Course {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  short_name      String
  description     String
  duration_months Int
  price           Decimal  @db.Decimal(10, 2)
  overview_points Json     @default("[]")
  tools_covered   Json     @default("[]")
  is_active       Boolean  @default(true)
  thumbnail_url   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  batches            Batch[]
  tutor_applications TutorApplication[]
  discount_codes     DiscountCode[]

  @@index([is_active])
  @@map("courses")
}

model TutorApplication {
  id String @id @default(cuid())

  name  String
  email String
  phone String

  occupation      String
  years_exp       Int
  companies       String
  work_experience String

  course_id String
  course    Course @relation(fields: [course_id], references: [id])

  time_slots Json @default("[]")

  hide_identity Boolean @default(false)
  location      String
  languages     Json    @default("[]")

  status         ApplicationStatus @default(PENDING)
  applied_on     DateTime          @default(now())
  reviewed_on    DateTime?
  rejection_note String?

  user_id String? @unique
  user    User?   @relation(fields: [user_id], references: [id])

  syllabus_sessions SyllabusTemplate[]
  syllabus_projects SyllabusProject[]

  @@index([course_id])
  @@index([status])
  @@index([phone])
  @@index([email])
  @@map("tutor_applications")
}

model SyllabusTemplate {
  id             String           @id @default(cuid())
  application_id String
  application    TutorApplication @relation(fields: [application_id], references: [id])
  session_number Int
  name           String
  type           SessionType      @default(BOTH)

  @@index([application_id])
  @@map("syllabus_templates")
}

model SyllabusProject {
  id             String           @id @default(cuid())
  application_id String
  application    TutorApplication @relation(fields: [application_id], references: [id])
  name           String
  highlights     Json             @default("[]")

  @@index([application_id])
  @@map("syllabus_projects")
}

model Batch {
  id           String      @id @default(cuid())
  course_id    String
  course       Course      @relation(fields: [course_id], references: [id])
  tutor_id     String
  tutor        User        @relation("TutorBatches", fields: [tutor_id], references: [id])
  name         String
  start_date   DateTime
  end_date     DateTime
  max_students Int         @default(50)
  description  String?
  zoom_link    String?
  time_slots   Json        @default("[]")
  status       BatchStatus @default(PENDING_APPROVAL)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  enrollments        Enrollment[]
  scheduled_sessions ScheduledSession[]
  assignments        Assignment[]
  queries            Query[]
  discount_codes     DiscountCode[]

  @@index([course_id])
  @@index([tutor_id])
  @@index([status])
  @@index([start_date])
  @@map("batches")
}

model Enrollment {
  id             String        @id @default(cuid())
  student_id     String
  student        User          @relation(fields: [student_id], references: [id])
  batch_id       String
  batch          Batch         @relation(fields: [batch_id], references: [id])
  enrolled_at    DateTime      @default(now())
  payment_status PaymentStatus @default(PENDING)
  payment_ref    String?
  progress       Int           @default(0)

  enrolled_price Decimal?  @db.Decimal(10, 2)
  original_price Decimal?  @db.Decimal(10, 2)
  discount_code  String?
  emi_first_due  DateTime?
  emi_second_due DateTime?

  installments EnrollmentInstallment[]

  @@unique([student_id, batch_id])
  @@index([student_id])
  @@index([batch_id])
  @@index([payment_status])
  @@map("enrollments")
}

model EnrollmentInstallment {
  id            String     @id @default(cuid())
  enrollment_id String
  enrollment    Enrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)

  installment_no Int
  label          String
  amount         Decimal @db.Decimal(10, 2)

  due_date DateTime?
  paid_at  DateTime?

  status         String  @default("PENDING")
  payment_method String?
  payment_ref    String?
  notes          String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([enrollment_id, installment_no])
  @@index([enrollment_id])
  @@index([status])
  @@index([due_date])
  @@map("enrollment_installments")
}

model ReferralReward {
  id                      String    @id @default(cuid())
  referrer_id             String
  referrer                User      @relation("ReferralsMade", fields: [referrer_id], references: [id], onDelete: Cascade)
  referred_student_id     String?   @unique
  referred_student        User?     @relation("ReferralsReceived", fields: [referred_student_id], references: [id], onDelete: SetNull)
  pending_registration_id String?
  enrollment_id           String?
  referral_code           String
  reward_amount           Decimal   @default(2000) @db.Decimal(10, 2)
  status                  String    @default("PENDING")
  eligible_at             DateTime?
  credited_at             DateTime?
  notes                   String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@index([referrer_id])
  @@index([referred_student_id])
  @@index([status])
  @@index([eligible_at])
  @@map("referral_rewards")
}

model ScheduledSession {
  id               String                 @id @default(cuid())
  batch_id         String
  batch            Batch                  @relation(fields: [batch_id], references: [id])
  session_number   Int
  name             String
  type             SessionType            @default(BOTH)
  scheduled_at     DateTime?
  duration_minutes Int                    @default(90)
  zoom_link        String?
  recording_url    String?
  notes_url        String?
  status           ScheduledSessionStatus @default(UPCOMING)
  created_at       DateTime               @default(now())

  assignments Assignment[]
  queries     Query[]

  @@unique([batch_id, session_number])
  @@index([batch_id])
  @@index([status])
  @@index([scheduled_at])
  @@map("scheduled_sessions")
}

model Assignment {
  id                String            @id @default(cuid())
  batch_id          String
  batch             Batch             @relation(fields: [batch_id], references: [id])
  session_id        String?
  session           ScheduledSession? @relation(fields: [session_id], references: [id])
  title             String
  description       String?
  file_url          String?
  storage_provider  String            @default("LOCAL")
  drive_file_id     String?
  original_filename String?
  file_mime_type    String?
  file_size         Int?
  due_date          DateTime?
  created_at        DateTime          @default(now())

  submissions AssignmentSubmission[]

  @@index([batch_id])
  @@index([session_id])
  @@index([due_date])
  @@index([drive_file_id])
  @@map("assignments")
}

model AssignmentSubmission {
  id                 String           @id @default(cuid())
  assignment_id      String
  assignment         Assignment       @relation(fields: [assignment_id], references: [id])
  student_id         String
  student            User             @relation(fields: [student_id], references: [id])
  file_url           String
  storage_provider   String           @default("LOCAL")
  drive_file_id      String?
  original_filename  String?
  file_mime_type     String?
  file_size          Int?
  first_submitted_at DateTime?
  submitted_at       DateTime         @default(now())
  editable_until     DateTime?
  locked_at          DateTime?
  replacement_count  Int              @default(0)
  status             SubmissionStatus @default(SUBMITTED)
  grade              String?
  feedback           String?
  reviewed_at        DateTime?

  @@unique([assignment_id, student_id])
  @@index([assignment_id])
  @@index([student_id])
  @@index([status])
  @@index([submitted_at])
  @@index([editable_until])
  @@index([drive_file_id])
  @@map("assignment_submissions")
}

model Query {
  id             String            @id @default(cuid())
  student_id     String
  student        User              @relation(fields: [student_id], references: [id])
  session_id     String?
  session        ScheduledSession? @relation(fields: [session_id], references: [id])
  batch_id       String
  batch          Batch             @relation(fields: [batch_id], references: [id])
  question       String
  attachment_url String?
  answer         String?
  status         QueryStatus       @default(OPEN)
  created_at     DateTime          @default(now())
  answered_at    DateTime?

  @@index([student_id])
  @@index([batch_id])
  @@index([session_id])
  @@index([status])
  @@index([created_at])
  @@map("queries")
}

model PendingRegistration {
  id                 String        @id @default(cuid())
  name               String
  email              String
  phone              String
  password_hash      String
  course_id          String
  batch_id           String
  phone_verified     Boolean       @default(false)
  payment_status     PaymentStatus @default(PENDING)
  payment_request_id String?       @unique
  payment_id         String?

  enrolled_price Decimal?  @db.Decimal(10, 2)
  original_price Decimal?  @db.Decimal(10, 2)
  discount_code  String?
  referral_code  String?
  emi_first_due  DateTime?
  emi_second_due DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  payments RegistrationPayment[]

  @@index([email])
  @@index([phone])
  @@index([course_id])
  @@index([batch_id])
  @@index([payment_status])
  @@index([referral_code])
  @@map("pending_registrations")
}

model RegistrationPayment {
  id                      String              @id @default(cuid())
  pending_registration_id String
  pending_registration    PendingRegistration @relation(fields: [pending_registration_id], references: [id], onDelete: Cascade)
  provider                String              @default("instamojo")
  amount                  Decimal             @db.Decimal(10, 2)
  status                  PaymentStatus       @default(PENDING)
  payment_request_id      String?             @unique
  payment_id              String?
  raw_response            Json?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  @@index([pending_registration_id])
  @@index([status])
  @@map("registration_payments")
}

model DiscountCode {
  id             String    @id @default(cuid())
  code           String    @unique
  purpose        String?
  discount_price Decimal   @db.Decimal(10, 2)
  original_price Decimal?  @db.Decimal(10, 2)
  course_id      String?
  course         Course?   @relation(fields: [course_id], references: [id])
  batch_id       String?
  batch          Batch?    @relation(fields: [batch_id], references: [id])
  starts_at      DateTime?
  expires_at     DateTime
  max_uses       Int?
  used_count     Int       @default(0)
  is_active      Boolean   @default(true)
  created_by_id  String?
  created_by     User?     @relation("DiscountCodeCreatedBy", fields: [created_by_id], references: [id])
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([code])
  @@index([course_id])
  @@index([batch_id])
  @@index([expires_at])
  @@index([is_active])
  @@map("discount_codes")
}

model PrerequisiteCourse {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  description String
  icon        String   @default("▶")
  order_index Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  lessons PrerequisiteLesson[]

  @@index([is_active])
  @@index([order_index])
  @@map("prerequisite_courses")
}

model PrerequisiteLesson {
  id                 String             @id @default(cuid())
  course_id          String
  course             PrerequisiteCourse @relation(fields: [course_id], references: [id], onDelete: Cascade)
  order_number       Int
  title              String
  description        String?
  vimeo_url          String
  duration_seconds   Int                @default(600)
  completion_percent Int                @default(90)
  is_active          Boolean            @default(true)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  progress PrerequisiteProgress[]

  @@unique([course_id, order_number])
  @@index([course_id])
  @@index([is_active])
  @@map("prerequisite_lessons")
}

model PrerequisiteProgress {
  id              String             @id @default(cuid())
  student_id      String
  student         User               @relation(fields: [student_id], references: [id], onDelete: Cascade)
  lesson_id       String
  lesson          PrerequisiteLesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  watched_seconds Int                @default(0)
  last_position   Int                @default(0)
  completed_at    DateTime?
  updated_at      DateTime           @updatedAt
  created_at      DateTime           @default(now())

  @@unique([student_id, lesson_id])
  @@index([student_id])
  @@index([lesson_id])
  @@index([completed_at])
  @@map("prerequisite_progress")
}

model RefreshToken {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}
