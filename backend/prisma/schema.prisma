// DigitalCAD Training - Supabase PostgreSQL + Prisma schema
// Use with Supabase Postgres. For local setup run:
// npx prisma generate
// npx prisma db push
// npm run db:seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionType {
  THEORY
  CAD
  BOTH
}

enum BatchStatus {
  PENDING_APPROVAL
  UPCOMING
  ACTIVE
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ScheduledSessionStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  RESUBMIT
}

enum QueryStatus {
  OPEN
  RESOLVED
}

enum OtpPurpose {
  STUDENT_REGISTER
  TUTOR_REGISTER
  LOGIN
  PASSWORD_RESET
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String   @unique
  password_hash String
  role          Role     @default(STUDENT)
  is_verified   Boolean  @default(false)
  is_active     Boolean  @default(true)
  avatar_url    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  enrollments        Enrollment[]
  tutor_application  TutorApplication?
  tutor_batches      Batch[]                @relation("TutorBatches")
  submissions        AssignmentSubmission[]
  queries            Query[]
  refresh_tokens     RefreshToken[]

  @@index([role])
  @@index([is_active])
  @@map("users")
}

model OtpVerification {
  id         String     @id @default(cuid())
  phone      String
  otp        String
  purpose    OtpPurpose
  expires_at DateTime
  is_used    Boolean    @default(false)
  attempts   Int        @default(0)
  created_at DateTime   @default(now())

  @@index([phone, purpose])
  @@index([expires_at])
  @@map("otp_verifications")
}

model Course {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  short_name      String
  description     String
  duration_months Int
  price           Decimal  @db.Decimal(10, 2)
  overview_points Json     @default("[]")
  tools_covered   Json     @default("[]")
  is_active       Boolean  @default(true)
  thumbnail_url   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  batches             Batch[]
  tutor_applications  TutorApplication[]

  @@index([is_active])
  @@map("courses")
}

model TutorApplication {
  id    String @id @default(cuid())

  name  String
  email String
  phone String

  occupation      String
  years_exp       Int
  companies       String
  work_experience String

  course_id String
  course    Course @relation(fields: [course_id], references: [id])

  time_slots Json @default("[]")

  hide_identity Boolean @default(false)
  location      String
  languages     Json    @default("[]")

  status         ApplicationStatus @default(PENDING)
  applied_on     DateTime          @default(now())
  reviewed_on    DateTime?
  rejection_note String?

  user_id String? @unique
  user    User?   @relation(fields: [user_id], references: [id])

  syllabus_sessions SyllabusTemplate[]
  syllabus_projects SyllabusProject[]

  @@index([course_id])
  @@index([status])
  @@index([phone])
  @@index([email])
  @@map("tutor_applications")
}

model SyllabusTemplate {
  id              String           @id @default(cuid())
  application_id  String
  application     TutorApplication @relation(fields: [application_id], references: [id])
  session_number  Int
  name            String
  type            SessionType      @default(BOTH)

  @@index([application_id])
  @@map("syllabus_templates")
}

model SyllabusProject {
  id             String           @id @default(cuid())
  application_id String
  application    TutorApplication @relation(fields: [application_id], references: [id])
  name           String
  highlights     Json             @default("[]")

  @@index([application_id])
  @@map("syllabus_projects")
}

model Batch {
  id           String      @id @default(cuid())
  course_id    String
  course       Course      @relation(fields: [course_id], references: [id])
  tutor_id     String
  tutor        User        @relation("TutorBatches", fields: [tutor_id], references: [id])
  name         String
  start_date   DateTime
  end_date     DateTime
  max_students Int         @default(50)
  description  String?
  zoom_link    String?
  time_slots   Json        @default("[]")
  status       BatchStatus @default(PENDING_APPROVAL)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  enrollments        Enrollment[]
  scheduled_sessions ScheduledSession[]
  assignments        Assignment[]
  queries            Query[]

  @@index([course_id])
  @@index([tutor_id])
  @@index([status])
  @@index([start_date])
  @@map("batches")
}

model Enrollment {
  id             String        @id @default(cuid())
  student_id     String
  student        User          @relation(fields: [student_id], references: [id])
  batch_id       String
  batch          Batch         @relation(fields: [batch_id], references: [id])
  enrolled_at    DateTime      @default(now())
  payment_status PaymentStatus @default(PENDING)
  payment_ref    String?
  progress       Int           @default(0)

  @@unique([student_id, batch_id])
  @@index([student_id])
  @@index([batch_id])
  @@index([payment_status])
  @@map("enrollments")
}

model ScheduledSession {
  id               String                 @id @default(cuid())
  batch_id         String
  batch            Batch                  @relation(fields: [batch_id], references: [id])
  session_number   Int
  name             String
  type             SessionType            @default(BOTH)
  scheduled_at     DateTime?
  duration_minutes Int                    @default(90)
  zoom_link        String?
  recording_url    String?
  notes_url        String?
  status           ScheduledSessionStatus @default(UPCOMING)
  created_at       DateTime               @default(now())

  assignments Assignment[]
  queries     Query[]

  @@index([batch_id])
  @@index([status])
  @@index([scheduled_at])
  @@unique([batch_id, session_number])
  @@map("scheduled_sessions")
}

model Assignment {
  id          String            @id @default(cuid())
  batch_id    String
  batch       Batch             @relation(fields: [batch_id], references: [id])
  session_id  String?
  session     ScheduledSession? @relation(fields: [session_id], references: [id])
  title       String
  description String?
  file_url    String?
  due_date    DateTime?
  created_at  DateTime          @default(now())

  submissions AssignmentSubmission[]

  @@index([batch_id])
  @@index([session_id])
  @@index([due_date])
  @@map("assignments")
}

model AssignmentSubmission {
  id            String           @id @default(cuid())
  assignment_id String
  assignment    Assignment       @relation(fields: [assignment_id], references: [id])
  student_id    String
  student       User             @relation(fields: [student_id], references: [id])
  file_url      String
  submitted_at  DateTime         @default(now())
  status        SubmissionStatus @default(SUBMITTED)
  grade         String?
  feedback      String?
  reviewed_at   DateTime?

  @@unique([assignment_id, student_id])
  @@index([assignment_id])
  @@index([student_id])
  @@index([status])
  @@index([submitted_at])
  @@map("assignment_submissions")
}

model Query {
  id          String            @id @default(cuid())
  student_id  String
  student     User              @relation(fields: [student_id], references: [id])
  session_id  String?
  session     ScheduledSession? @relation(fields: [session_id], references: [id])
  batch_id    String
  batch       Batch             @relation(fields: [batch_id], references: [id])
  question    String
  answer      String?
  status      QueryStatus       @default(OPEN)
  created_at  DateTime          @default(now())
  answered_at DateTime?

  @@index([student_id])
  @@index([batch_id])
  @@index([session_id])
  @@index([status])
  @@index([created_at])
  @@map("queries")
}

model RefreshToken {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}
